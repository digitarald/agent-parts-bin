{
  "name": "agent-parts-bin",
  "description": "Rough agent-plugin experiments.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "node .github/scripts/build.mjs && node .github/scripts/build-canvases.mjs",
    "build:check": "node .github/scripts/build.mjs --check && node .github/scripts/build-canvases.mjs --check",
    "test:canvas": "node .github/scripts/test-canvases.mjs",
    "test:canvas:browser": "playwright test canvases/session-todos",
    "check": "node .github/scripts/typecheck.mjs && node .github/scripts/validate.mjs",
    "test": "node --test \"test/*.test.mjs\" \".github/scripts/*.test.mjs\"",
    "verify": "npm run check && npm run build:check && npm test && npm run test:canvas",
    "eval:check": "node .github/scripts/validate-evals.mjs",
    "eval:lint": "node .github/scripts/evals.mjs lint",
    "eval:smoke": "vally eval --suite smoke --workers 1 --max-retries 1 --model gpt-6.1-terra",
    "eval": "vally eval --workers 1 --max-retries 1 --model gpt-6.1-terra",
    "eval:grade": "node .github/scripts/evals.mjs grade",
    "eval:report": "node .github/scripts/eval-report.mjs",
    "eval:report:selection": "node .github/scripts/legacy-eval-report.mjs",
    "eval:list": "node .github/scripts/evals.mjs eval --list",
    "new-plugin": "node .github/scripts/new-plugin.mjs",
    "remove-plugin": "node .github/scripts/remove-plugin.mjs",
    "remove-example": "node .github/scripts/remove-plugin.mjs --example",
    "rename-marketplace": "node .github/scripts/rename-marketplace.mjs",
    "check-remotes": "node .github/scripts/check-remote-pins.mjs",
    "lint": "node .github/scripts/lint.mjs",
    "eval:models": "vally experiment run evals/standard-models.experiment.yaml --output-dir evals/results/standard-models --require-pass",
    "eval:compare": "node .github/scripts/eval-report.mjs"
  },
  "devDependencies": {
    "@rwoll/canvas-kit": "0.3.0",
    "@playwright/test": "1.60.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@github/copilot": "1.0.98",
    "@microsoft/vally-cli": "0.21.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "@microsoft/vally": "0.21.0"
  },
  "overrides": {
    "@github/copilot-sdk": "1.0.31"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/digitarald/agent-parts-bin"
  }
}
